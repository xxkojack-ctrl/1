-- Function to create 7 popups at once
local function createMultiplePopups()
	for i, pos in ipairs(popupPositions) do
		task.delay(i * 0.1, function()
			createPopup(pos.xPercent, pos.yPercent)
		end)
	end
end

-- Feature buttons array
local features = {
	{name = "🛫 FLY", successRate = "10-20%"},
	{name = "🏊 SWIM", successRate = "40-50%"},
	{name = "💥 FLING", successRate = "5%"},
	{name = "👻 PHASE", successRate = "40%"}
}

local buttonSize = 110
local buttonsPerRow = 4
local yPos = 190

for i, feature in ipairs(features) do
	local col = ((i - 1) % buttonsPerRow)
	local row = math.floor((i - 1) / buttonsPerRow)
	
	local featureButton = Instance.new("TextButton")
	featureButton.Name = feature.name
	featureButton.Size = UDim2.new(0, buttonSize, 0, 55)
	featureButton.Position = UDim2.new(0, 10 + (col * 120), 0, yPos + (row * 65))
	featureButton.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
	featureButton.BorderColor3 = Color3.fromRGB(100, 200, 255)
	featureButton.BorderSizePixel = 1
	featureButton.TextColor3 = Color3.fromRGB(255, 255, 255)
	featureButton.TextSize = 11
	featureButton.Font = Enum.Font.GothamBold
	featureButton.Text = feature.name .. "\n" .. feature.successRate
	featureButton.Parent = mainFrame
	
	featureButton.MouseEnter:Connect(function()
		featureButton.BackgroundColor3 = Color3.fromRGB(70, 70, 100)
	end)
	featureButton.MouseLeave:Connect(function()
		featureButton.BackgroundColor3 = Color3.fromRGB(50, 50, 70)
	end)
	
	featureButton.MouseButton1Click:Connect(function()
		createMultiplePopups()
		featureButton.BorderColor3 = Color3.fromRGB(100, 255, 100)
		featureButton.Text = feature.name .. " ✓\n" .. feature.successRate
		task.wait(0.3)
		featureButton.BorderColor3 = Color3.fromRGB(100, 200, 255)
		featureButton.Text = feature.name .. "\n" .. feature.successRate
	end)
end

