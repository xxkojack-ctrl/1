refreshLists()
local function resolveName(v)
    v = v:gsub("^%s+",""):gsub("%s+$","")
    if v=="" then return end
    local low = v:lower()
    for _, p in Plrs:GetPlayers() do
        if p.Name:lower()==low or p.DisplayName:lower()==low then return p.Name end
    end
    for _, p in Plrs:GetPlayers() do
        if p.Name:lower():sub(1,#low)==low or p.DisplayName:lower():sub(1,#low)==low then return p.Name end
    end
    return v
end
