local function taskState(key, tname)
    local hq = holderQ(key)
    local tasks = hq and hq:FindFirstChild("Tasks")
    local t = tasks and tasks:FindFirstChild(tname)
    local v, mx = t and t:FindFirstChild("Value"), t and t:FindFirstChild("Max")
    return v and v.Value or 0, mx and mx.Value or 1, t
end

local function runQuest(key)
    local q = QuestsMod.Holder[key]
    local se = getSE()
    status = "taking: "..key
    if not holderQ(key) then
        local gp = giverPos(key)
        if not gp then return false end
        local t0, tries = os.clock(), 0
        while running and not holderQ(key) and os.clock() - t0 < 90 do
            local okAdd, why = QuestsMod.CanAddQuest(lp, key)
            if not okAdd and why~=true then return false end
            goNear(gp)
            pcall(se.ToServer, "AddQuest", key)
            task.wait(2.5)
            tries += 1
            if not holderQ(key) then status = "quest cooldown (max 30s): "..key end
        end
        if not holderQ(key) then return running and "retry" or false end
    end
    local tasks = q.QuestInstance.Tasks:GetChildren()
    for _, t in ipairs(tasks) do
        local sp = q.TaskSpecs[t.Name]
        local tries = 0
        while running do
            local v, mx, live = taskState(key, t.Name)
            if not live then break end
            if v>=mx then break end
            if QuestsMod.TaskNeedMet and QuestsMod.TaskNeedMet(live)==false then task.wait(0.5); tries += 1; if tries>20 then return false end; continue end
            status = key.." · "..t.Name.." "..v.."/"..mx
            local before = v
            if sp.Type=="Deliver" then
                goNear(npcPos(sp.TargetNpc))
                pcall(se.ToServer, "QuestProgress", key, t.Name)
                task.wait(1.2)
            elseif sp.Type=="Pickup" and sp.Anchor then
                goNear(v3(sp.Anchor), Vector3.new(0, 2.5, 0))
                for i = 1, (sp.SpawnCount or 1) do
                    if not running then break end
                    local cv, cmx = taskState(key, t.Name)
                    if cv>=cmx then break end
                    pcall(se.ToServer, "QuestProgress", key, t.Name, i)
                    task.wait(0.15)
                end
                task.wait(0.8)
            elseif sp.Type=="Pickup" then
                local hq = holderQ(key)
                local n = typeof(sp.Positions)=="function" and (sp.SpawnCount or 1) or #sp.Positions
                for i = 1, n do
                    if not running then break end
                    local cv, cmx = taskState(key, t.Name)
                    if cv>=cmx then break end
                    local picked = hq and hq:GetAttribute("Picked"..i)
                    if picked~=true or sp.RespawnTime~=nil then
                        local pos
                        if typeof(sp.Positions)=="function" then
                            local ok2, p = pcall(sp.Positions, i)
                            pos = ok2 and v3(p) or nil
                        else
                            pos = v3(sp.Positions[i])
                        end
                        if pos then
                            goNear(pos, Vector3.new(0, 2, 0))
                            pcall(se.ToServer, "QuestProgress", key, t.Name, i)
                            task.wait(0.35)
                        end
                    end
                end
                task.wait(0.8)
            end
            local after = taskState(key, t.Name)
            if after<=before then
                tries += 1
                if tries>=3 then return false end
            else
                tries = 0
            end
        end
    end
    task.wait(1.5)
    return holderQ(key)==nil
end

