local function Maid()
    local m = {_t = {}}
    function m:give(x) self._t[#self._t+1] = x; return x end
    function m:clean()
        local t = self._t
        self._t = {}
        for i = #t, 1, -1 do
            local x = t[i]
            pcall(function()
                local tx = typeof(x)
                if tx=="RBXScriptConnection" then x:Disconnect()
                elseif tx=="Instance" then x:Destroy()
                elseif tx=="function" then x()
                elseif tx=="thread" then task.cancel(x)
                elseif x.Remove then x:Remove()
                elseif x.Disconnect then x:Disconnect()
                end
            end)
        end
    end
    return m
end
