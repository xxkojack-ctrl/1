local function bestTarget(m)
    local best, bestDist = nil, math.huge
    for _, p in Plrs:GetPlayers() do
        local ok, _, _, c = passFilter(p, cfg.aim)
        if not ok then continue end
        local part = c:FindFirstChild(cfg.aim.part) or c:FindFirstChild("Head")
        if not part then continue end
        local sp, vis = cam:WorldToViewportPoint(part.Position)
        if not vis or sp.Z<=0 then continue end
        local d = (Vector2.new(sp.X, sp.Y) - m).Magnitude
        if d<=cfg.aim.fov and d<bestDist then best, bestDist = part, d end
    end
    return best
end

