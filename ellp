local function espTargets()
    local list = {}
    local me = getRoot(lp)
    local mp = me and me.Position
    if cfg.esp.players then
        for _, p in Plrs:GetPlayers() do
            local ok, h, r, c = passFilter(p, cfg.esp)
            if ok then list[#list+1] = {key=p, kind="player", h=h, r=r, c=c, p=p} end
        end
    end
    for m, kind in pairs(npcSet) do
        if not m.Parent then
            npcSet[m] = nil
            destroyObj(m)
        elseif cfg.esp[kindFlag[kind]] then
            local h = m:FindFirstChildOfClass("Humanoid")
            local r = m:FindFirstChild("HumanoidRootPart") or m.PrimaryPart
            if h and r and (h.Health>0 or not cfg.esp.aliveOnly)
                and (not mp or (r.Position-mp).Magnitude <= cfg.esp.npcMaxDist)
                and not (cfg.esp.visCheck and occluded(m, r.Position)) then
                list[#list+1] = {key=m, kind=kind, h=h, r=r, c=m}
            end
        end
    end
    for _, t in ipairs(list) do t.d = mp and (t.r.Position-mp).Magnitude or 0 end
    table.sort(list, function(a, b) return a.d < b.d end)
    return list
end

local function targetColor(t, o)
