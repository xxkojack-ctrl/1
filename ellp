end
local function v3(v)
    if typeof(v)=="CFrame" then return v.Position end
    if typeof(v)=="Vector3" then return v end
end

local function npcPos(name)
    local deb = workspace:FindFirstChild("Debree")
    deb = deb and deb:FindFirstChild("Regions")
    if deb then
        for _, reg in deb:GetChildren() do
            local sn = reg:FindFirstChild("StationaryNpcs")
            local m = sn and sn:FindFirstChild(name)
            if m and m:IsA("Model") then return m:GetPivot().Position end
        end
    end
    if RegionsMod and RegionsMod.Regions then
        for _, reg in pairs(RegionsMod.Regions) do
            for k, n in pairs(reg.Npcs or {}) do
                local nm = type(n)=="table" and n.Name or k
                if nm==name and type(n)=="table" and n.Spawns and n.Spawns[1] then return v3(n.Spawns[1]) end
            end
        end
    end
end

local function holderQ(key)
    local q = QuestsMod.Holder[key]
    local s = getSlot(lp)
    local H = s and s:FindFirstChild("Quests")
    H = H and H:FindFirstChild("Holder")
    return H and q and q.QuestInstance and H:FindFirstChild(q.QuestInstance.Name)
end
local function hasItem(name)
    local s = getSlot(lp)
    local inv = s and s:FindFirstChild("Inventory")
    inv = inv and inv:FindFirstChild("Inventory")
    return inv and inv:FindFirstChild(name)~=nil
end

local function taskSupported(q, tname, produced)
    local sp = q.TaskSpecs and q.TaskSpecs[tname]
    if type(sp)~="table" then return false end
    if sp.Type=="Deliver" and type(sp.TargetNpc)=="string" then
        if sp.RequiredItem and not produced[sp.RequiredItem] and not hasItem(sp.RequiredItem) then return false end
        return npcPos(sp.TargetNpc)~=nil
    end
    if sp.Type=="Pickup" and sp.Positions~=nil then
        if sp.GrantItem then produced[sp.GrantItem] = true end
        return true
    end
    return false
end
local function questSupported(key)
    local q = QuestsMod.Holder[key]
    if not q or q.Category~="Dialogue" then return false end
    if q.ConsumeItemOnAccept and not holderQ(key) and not hasItem(q.ConsumeItemOnAccept) then return false end
    if q.ItemCostOnAccept or q.WenCostOnAccept then return false end
    local tasks = q.QuestInstance and q.QuestInstance:FindFirstChild("Tasks")
    if not tasks or #tasks:GetChildren()==0 then return false end
    local produced = {}
    if q.GrantItemOnAccept then produced[q.GrantItemOnAccept] = true end
    for _, t in tasks:GetChildren() do
        if not taskSupported(q, t.Name, produced) then return false end
    end
    return holderQ(key)~=nil or giverPos(key)~=nil
end

local failed = {}
local function candidates()
    local lvl = myLevel()
    local list = {}
    for key, q in pairs(QuestsMod.Holder) do
        if not failed[key] and q.Category=="Dialogue" and (q.LogCompletion==true or cfg.extra.storyRepeat or holderQ(key)) then
            local req = q.Requirements and q.Requirements.Level or 0
            if req<=lvl and questSupported(key) then
                local active = holderQ(key)~=nil
                local okAdd, why = QuestsMod.CanAddQuest(lp, key)
                if active or okAdd or why==true then
                    list[#list+1] = {key=key, exp=(q.Rewards and q.Rewards.Exp) or 0, active=active, once=q.LogCompletion==true}
                end
            end
        end
    end
    table.sort(list, function(a, b)
        if a.active~=b.active then return a.active end
        if a.once~=b.once then return a.once end
        return a.exp>b.exp
    end)
    return list
end

