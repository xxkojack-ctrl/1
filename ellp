            local have = {}
            for _, n in ipairs(slotNames) do
                local v = st:FindFirstChild(n)
                if v and v.Value~=0 then have[v.Value] = n end
            end
            local ci = 1
            for _, n in ipairs(slotNames) do
                local v = st:FindFirstChild(n)
                if v and (v.Value==0 or not want[v.Value]) then
                    while cand[ci] and (have[cand[ci].id] or not want[cand[ci].id]) do ci += 1 end
                    local x = cand[ci]
                    if x then
                        pcall(se.ToServer, "AccessoryEquip", n, x.id, "Stats")
                        have[x.id] = n
                        ci += 1
                    end
                end
            end
        end
