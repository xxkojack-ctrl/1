local gcCache = {}
local function gcFind(key, test)
    local e = gcCache[key]
    if e and e.ref then return e.ref end
    local now = os.clock()
    if e and now - e.at < 5 then return end
    for _, t in getgc(true) do
        if type(t)=="table" and test(t) then
            gcCache[key] = {ref=t, at=now}
            return t
        end
    end
    gcCache[key] = {at=now}
end
