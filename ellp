local remLogs  = {}
local remOn    = false
local remOrig  = nil
local remSE    = nil
local remDirty = false

local function ser(v, depth)
    local t = typeof(v)
    if t=="string" then return string.format("%q", v) end
    if t=="Instance" then return v:GetFullName() end
    if t=="table" then
        if depth>=2 then return "{...}" end
        local parts, n = {}, 0
        for k, x in pairs(v) do
            n += 1
            if n>8 then parts[#parts+1]="..."; break end
            parts[#parts+1] = tostring(k).."="..ser(x, depth+1)
        end
        return "{"..table.concat(parts,", ").."}"
    end
    return tostring(v)
end
local function remPush(ev, ...)
    local n = select("#", ...)
    local parts = table.create(n)
    for i = 1, n do parts[i] = ser((select(i, ...)), 0) end
    local entry = string.format("[%s] %s | %s", os.date("%H:%M:%S"), tostring(ev), table.concat(parts, ", "))
    table.insert(remLogs, 1, entry)
    if #remLogs > 100 then remLogs[#remLogs] = nil end
    remDirty = true
    if cfg.remote.print then print("[RLOG] "..entry) end
end

local function getSE()
    local ok, se = pcall(function()
        return require(RS.Communication.ServerAndClient.Signals.SignalEvent)
    end)
    return ok and type(se)=="table" and se or nil
end
local function remStart()
    if remOrig then return end
    local se = getSE()
    if not se or type(se.ToServer)~="function" then return false end
    remSE, remOrig = se, se.ToServer
    local orig = remOrig
    se.ToServer = function(ev, ...)
        if remOn then pcall(remPush, ev, ...) end
        return orig(ev, ...)
    end
    return true
end
local function remStop()
    if remSE and remOrig then remSE.ToServer = remOrig end
    remSE, remOrig = nil, nil
end

