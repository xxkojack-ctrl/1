local qAddAt, qTries, qWait = 0, 0, nil
local qProg = {key=nil, sum=0, at=0}
local function doQuest()
    if not QuestsMod then return false end
    local q, key = activeCombatQuest()
    local wen = cfg.farm.breath and F.breathWen
    local wantFarm = cfg.farm.level or cfg.farm.questFarm or wen
    if q and key and key:find(" Breathing(", 1, true) then return false end
    if q then
        qTries = 0
        if not wantFarm then return false end
        local codes = remainingCodes(q)
        if #codes==0 then return false end
        local types = {}
        for _, c in ipairs(codes) do
            for _, t in ipairs(typesForCode(c)) do types[#types+1] = t end
        end
        if #types==0 then return false end
        fm.note = "quest: "..q.Name
        local sum = 0
        local tf = q:FindFirstChild("Tasks")
        if tf then
            for _, t in tf:GetChildren() do
                local v = t:FindFirstChild("Value")
                if v then sum += v.Value end
            end
        end
        if qProg.key~=key or sum>qProg.sum then
            qProg.key, qProg.sum, qProg.at = key, sum, os.clock()
        elseif cfg.farm.level and os.clock() - qProg.at > 75 then
            questBlock[key] = os.clock() + 600
            qProg.key = nil
            pcall(getSE().ToServer, "RemoveQuest", q.Name)
            fm.note = "too slow, skipping: "..q.Name
            return false
        end
        local res = farmTypes(types)
        if fm.note:find("respawn", 1, true) then
            qWait = qWait or os.clock()
            if os.clock() - qWait > 60 and cfg.farm.level then
                questBlock[key] = os.clock() + 180
                qWait = nil
                pcall(getSE().ToServer, "RemoveQuest", q.Name)
            end
        else
            qWait = nil
        end
        return res
    end
    qWait = nil
    local pick
    if cfg.farm.level or wen or cfg.farm.questSel=="Best" then pick = bestQuest() else pick = cfg.farm.questSel end
    if not pick or not QuestsMod.Holder[pick] then return false end
    local okAdd, reason = QuestsMod.CanAddQuest(lp, pick)
    local gp = giverPos(pick)
    if not okAdd then
        if reason==true and gp then
            fm.note = "quest cooldown, waiting at giver: "..pick
            if near(gp, 8) then fm.goal = nil else goPos(gp + Vector3.new(0, 1, 4), gp) end
            return true
        end
        fm.note = "quest locked"
        return false
    end
    if not gp then return false end
    fm.note = qTries>=2 and ("taking quest (server cooldown, max 30s): "..pick) or ("taking: "..pick)
    if near(gp, 8) then
        fm.goal = nil
        if os.clock() - qAddAt > 2 then
            qAddAt = os.clock()
            qTries += 1
            pcall(getSE().ToServer, "AddQuest", pick)
        end
    else
        goPos(gp + Vector3.new(0, 1, 4), gp)
    end
    return true
end

