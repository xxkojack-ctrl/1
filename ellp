local function m1Fire()
    if m1.busy then return end
    local se = getSE()
    local pr, style, special = resolvePreset(combatStyle())
    if not se or not pr then return end
    m1.busy = true
    task.spawn(function()
        local now = os.clock()
        local mx = pr.Max or 5
        local window = (presetSnap and presetSnap.combo) or (CPmod and CPmod.combo_duration) or 1.35
        if now - m1.last > window or m1.idx>=mx then m1.idx = 0 end
        m1.idx += 1
        local i = m1.idx
        local sw, bh, def, fin = origTiming(pr, i)
        local mult = 1
        pcall(function() mult = CPmod.attackSpeedMult(lp) end)
        if special and not (SwingsFolder and SwingsFolder:FindFirstChild(special.."_Swings")) then special = nil end
        pcall(playSwing, style, special, i, pr)
        task.wait(sw/mult)
        if ClientFx then
            pcall(function() ClientFx:Fire((special or style).."_Swings", lp.Character, i, false) end)
        end
        pcall(se.ToServer, "Combat_Service", style, i, false, (bh-sw)/mult, false, special)
        m1.last = os.clock()
        local gap = ((i>=mx) and fin or def) + 0.02
        if i>=mx then m1.finUntil = os.clock() + math.max(gap/mult - 0.3, 0) end
        task.wait(math.max(gap/mult - sw/mult, 0.03))
        m1.busy = false
    end)
end

