        return true
    end
    local map = taskMap[name]
    local folder = workspace:FindFirstChild("Training")
    folder = folder and folder:FindFirstChild(map[1])
    local me = getRoot(lp)
    local best, bd
    if folder and me then
        for _, pp in folder:GetDescendants() do
            if pp:IsA("ProximityPrompt") and pp.Enabled then
                local pos = F.instPos(pp.Parent)
                local d = pos and (pos - me.Position).Magnitude
                if d and (not bd or d<bd) then best, bd = pp, d end
            end
        end
    end
    if best then
        fm.note = "breathing: starting "..name
        return F.usePrompt(best.Parent, best)
    end
    local mp = BR.markerPos(map[2])
    if not mp then fm.note = "breathing: no location for "..name; return false end
    fm.note = "breathing: going to "..name
    if F.near(mp, 30) then task.spawn(function() pcall(function() lp:RequestStreamAroundAsync(mp) end) end) end
    F.goPos(mp + Vector3.new(0, 4, 0), mp)
    return true
end

local function runQuest(q)
    local tasks = q:FindFirstChild("Tasks")
    if not tasks then return false end
    for _, t in tasks:GetChildren() do
        local v, mx, c = t:FindFirstChild("Value"), t:FindFirstChild("Max"), t:FindFirstChild("Code")
        local need = QuestsMod.TaskNeedMet and QuestsMod.TaskNeedMet(t)
        if v and mx and v.Value<mx.Value and need~=false then
            BR.status = "Task: "..t.Name.." ("..v.Value.."/"..mx.Value..")"
            if taskMap[t.Name] then return doTraining(t.Name) end
            local types = F.typesForCode(c and c.Value or t.Name)
            if #types>0 then
                fm.note = "breathing: "..t.Name
                return F.farmTypes(types)
            end
            fm.note = "breathing: unsupported task "..t.Name
            BR.status = "Unsupported task: "..t.Name.." (do it manually)"
            return false
        end
    end
    fm.note = "breathing: waiting for completion"
    return false
end

function F.doBreath()
    F.breathWen = false
    if not QuestsMod then return false end
    local style = cfg.farm.breathStyle
    local key = BR.key(style)
    if not key then BR.status = "Unknown style"; return false end
    local q = BR.quest(key)
    if q then return runQuest(q) end
    if BR.breathing()==style then
        BR.status = style.." Breathing learned"
        fm.note = "breathing: learned"
        return false
    end
    local items, wen, lvl = BR.needs(key)
    if F.myLevel()<lvl then BR.status = "Needs level "..lvl; fm.note = "breathing: level "..lvl.." needed"; return false end
    local missing = {}
    for _, it in ipairs(items) do
        if it.have<it.need then missing[#missing+1] = it end
    end
    if #missing>0 then
        if F.doLoot() then BR.status = "Picking up loot"; return true end
        local lv = F.myLevel()
        local weakest
        for pass = 1, 2 do
            for _, it in ipairs(missing) do
                local src = {}
                for _, t in ipairs(BR.sources(it.item)) do
                    local d = BR.diff(t.name)
                    if not weakest or d<weakest.d then weakest = {d=d, name=t.name, item=it.item} end
                    if d<=lv + BR.margin then src[#src+1] = t end
                end
                if pass==1 then src = BR.alive(src) end
                if #src>0 then
                    BR.status = "Farming "..it.item.." "..it.have.."/"..it.need
                    fm.note = "breathing: farming "..it.item.." "..it.have.."/"..it.need
                    return F.farmTypes(src)
                end
            end
        end
        if weakest then
            BR.status = "Leveling to "..(weakest.d - BR.margin).." for "..weakest.name.." ("..weakest.item..", Lv "..weakest.d.." content)"
            fm.note = "breathing: leveling up first"
            F.breathWen = true
            return false
        end
        fm.note = "breathing: no source for "..missing[1].item
        return false
    end
    if BR.wen()<wen then
        BR.status = "Farming Wen "..BR.wen().."/"..wen
        F.breathWen = true
        return false
    end
    local cq = F.activeCombatQuest()
    if cq then
        if os.clock() - BR.removeAt > 3 then BR.removeAt = os.clock(); pcall(getSE().ToServer, "RemoveQuest", cq.Name) end
        fm.note = "breathing: dropping "..cq.Name
        return true
    end
    local ok2, reason = QuestsMod.CanAddQuest(lp, key)
    if not ok2 then
        BR.status = reason==true and "Quest cooldown" or ("Cannot take: "..tostring(reason))
        fm.note = "breathing: "..BR.status
        return reason==true
    end
    local gp = giverPos(key)
    if not gp then BR.status = "Trainer not found"; return false end
    BR.status = "Taking "..key
    fm.note = "breathing: taking quest"
    if F.near(gp, 8) then
        fm.goal = nil
        if os.clock() - BR.addAt > 2 then BR.addAt = os.clock(); pcall(getSE().ToServer, "AddQuest", key) end
    else
        F.goPos(gp + Vector3.new(0, 1, 4), gp)
    end
    return true
end

local function finishTraining(tr)
    task.wait(math.max(tonumber(cfg.farm.trainDelay) or 3, 0.5))
    if not tr.Parent then return end
    local gp = tr:GetAttribute("GoalPosition")
    if typeof(gp)=="Vector3" then
        pcall(getSE().ToServer, "training_signaler", "StateChanged", true)
        local t0 = os.clock()
        while tr.Parent and os.clock() - t0 < 20 do
            local r = getRoot(lp)
            if r then
                local d = Vector3.new(gp.X, r.Position.Y, gp.Z) - r.Position
                local step = math.min(d.Magnitude, 1.2)
                if d.Magnitude>0.5 then
                    r.CFrame = CFrame.lookAt(r.Position + d.Unit*step, Vector3.new(gp.X, r.Position.Y, gp.Z))
                end
                r.AssemblyLinearVelocity = Vector3.zero
            end
            task.wait()
        end
        return
    end
    pcall(getSE().ToServer, "training_signaler", "Stop", true)
end
