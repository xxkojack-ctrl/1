local presetSnap
local function copyT(t)
    if type(t)~="table" then return nil end
    local o = {}
    for k, v in pairs(t) do o[k] = v end
    return o
end
local function snapPresets(cp)
    if presetSnap then return presetSnap end
    local pr = rawget(cp,"Presets")
    if type(pr)~="table" then return end
    presetSnap = {combo=cp.combo_duration, list={}}
    for _, c in pairs(pr) do
        if type(c)=="table" then
            presetSnap.list[c] = {
                default=c.default, final=c.final,
                dbh=c.default_before_hit, dbs=c.default_before_swing,
                anim=copyT(c.AnimSpeed), hit=copyT(c.delay_before_hit), swing=copyT(c.delay_before_swing),
            }
        end
    end
    return presetSnap
end
local function applyComboSpeed(on)
    local cp = findCombatPresets()
    if not cp then return end
    local snap = snapPresets(cp)
    if not snap then return end
    if not on then
        cp.combo_duration = snap.combo
        for c, s in pairs(snap.list) do
            c.default, c.final = s.default, s.final
            c.default_before_hit, c.default_before_swing = s.dbh, s.dbs
            c.AnimSpeed = copyT(s.anim)
            c.delay_before_hit = copyT(s.hit)
            c.delay_before_swing = copyT(s.swing)
        end
        return
    end
    local mul = cfg.combat.animSpeed
    for c, s in pairs(snap.list) do
        c.default, c.final = s.default, s.final
        c.default_before_hit, c.default_before_swing = s.dbh, s.dbs
        c.delay_before_hit = copyT(s.hit)
        c.delay_before_swing = copyT(s.swing)
        local a = {}
        if s.anim then
            for k, v in pairs(s.anim) do a[k] = type(v)=="number" and v*mul or v end
        end
        if a.Default==nil then a.Default = mul end
        c.AnimSpeed = a
    end
end

local m1FireRef, nearestMobRef

local function nearestTarget(range)
    local mr = getRoot(lp)
    if not mr then return end
    local best, bd
    if cfg.combat.autoPlayers then
        local filt = {aliveOnly=true, maxDist=range, teamCheck=cfg.aim.teamCheck, blacklist=cfg.aim.blacklist}
        for _, p in Plrs:GetPlayers() do
            local ok, _, r = passFilter(p, filt)
            if ok then
                local d = (r.Position-mr.Position).Magnitude
                if not bd or d<bd then best, bd = r, d end
            end
        end
    end
    if cfg.combat.autoNpcs and nearestMobRef then
        local t, d = nearestMobRef(function(_, kind) return kind~="civ" end)
        if t and d<=range and (not bd or d<bd) then best, bd = t.r, d end
    end
    return best, mr
end

