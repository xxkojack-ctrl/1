local function deepMerge(dst, src)
    for k, v in pairs(src) do
        local d = dst[k]
        if type(d)=="table" and type(v)=="table" then deepMerge(d, v)
        elseif d==nil or type(d)==type(v) then dst[k] = v end
    end
end
