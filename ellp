local function planner()
    local c = lp.Character
    local h = c and c:FindFirstChildOfClass("Humanoid")
    local r = getRoot(lp)
    if not (h and r) or h.Health<=0 then
        if not fm.deadMarked then
            fm.deadMarked = true
            if fm.lastType then deathAvoid[fm.lastType] = os.clock() + 600 end
            if r then deathSpots[#deathSpots+1] = {p=r.Position, t=os.clock() + 600} end
        end
        fm.goal, fm.target = nil, nil
        fm.note = "dead"..(fm.lastType and (", avoiding "..fm.lastType.." for 10 min") or "")
        return
    end
    fm.deadMarked = false
    if F.storyBusy then fm.goal, fm.target = nil, nil; fm.note = "story quest"; return end
    local f = cfg.farm
    local pct = h.MaxHealth>0 and h.Health/h.MaxHealth*100 or 100
    local fighting = f.level or f.questFarm or f.enemies or f.fast or f.bosses or f.fs or f.breath or f.chest or f.eventChest or (cfg.dungeon.farm and inDungeon())
    if not fighting then fm.retreat = false; fm.retreatPos = nil end
    if fighting and f.potion and pct<f.potionHp then usePotion() end
    if potBusy then
        fm.retreatPos = fm.retreatPos or (r.Position + Vector3.new(0, 90, 0))
        goPos(fm.retreatPos)
        fm.note = "drinking potion"
        return
    end
    if f.retreat and fighting and pct<f.retreatHp and not fm.retreat then fm.retreat = os.clock() end
    if fm.retreat then
        if pct>=f.resumeHp or os.clock() - fm.retreat > 120 then
            fm.retreat = false
            fm.retreatPos = nil
        else
            fm.retreatPos = fm.retreatPos or (r.Position + Vector3.new(0, 90, 0))
            goPos(fm.retreatPos)
            fm.note = "retreat"
            return
        end
    end
    if f.loot and doLoot() then return end
    if (f.chest or f.eventChest) and doChest(true) then return end
    if (f.chest or f.normalChest) and doChest(false) then return end
    if f.bosses and doBoss() then return end
    if cfg.dungeon.farm and inDungeon() and doDungeonFarm() then return end
    if f.fs and doFS() then return end
    if f.breath and F.doBreath then
        local ok2, res = pcall(F.doBreath)
        if not ok2 then fm.note = "breathing error: "..tostring(res):gsub("^.-:%d+: ", ""):sub(1, 80) elseif res then return end
    end
    if (f.level or f.questFarm or f.quest or (f.breath and F.breathWen)) and doQuest() then return end
    if f.enemies and doEnemies() then return end
    if f.fast and doFast() then return end
    if (f.chest or f.eventChest) and doSealedSweep() then return end
    fm.goal, fm.target = nil, nil
    fm.note = "idle"
end

local farmConn, planAt = nil, 0
local function farmTick(dt)
    local now = os.clock()
    if not anyFarm() then
        if next(farmNc) then farmNoclip(false) end
        fm.goal, fm.target = nil, nil
        return
    end
    if now - planAt>=0.15 then
        planAt = now
        planner()
    end
    local r = getRoot(lp)
    if not r then return end
    if fm.target then
        local t = fm.target
        if not t.m.Parent or t.h.Health<=0 then
            fm.target = nil
            fm.lastKill = now
            if F.onKill then pcall(F.onKill, t.m, npcSet[t.m]) end
        else
            fm.goal, fm.look = standFor(t)
        end
    end
    local evade = false
    if fm.target then
        evade = (cfg.farm.dodge and now < (fm.dodgeT or 0)) or (cfg.farm.safeCombo and now < (m1.finUntil or 0))
        if evade then
            local tp = fm.target.r.Position
            fm.goal, fm.look = tp + Vector3.new(0, cfg.farm.dodgeHeight, 0), tp
            fm.evading = true
        else
            fm.evading = false
        end
    end
    if not fm.goal then
        if next(farmNc) then farmNoclip(false) end
        return
    end
    farmNoclip(true)
    local pos = r.Position
    local d = fm.goal - pos
    local dist = d.Magnitude
    local np
    if cfg.farm.method=="Teleport" or dist<=10 or evade or (fm.target and dist<=cfg.farm.dodgeHeight + 12) then
        np = fm.goal
    else
        np = pos + d.Unit * math.min(dist, cfg.farm.tweenSpeed * dt)
    end
    local lk = fm.look or (np + r.CFrame.LookVector)
    local flat = Vector3.new(lk.X, np.Y, lk.Z)
    if (flat - np).Magnitude<0.05 then flat = np + r.CFrame.LookVector end
    r.CFrame = CFrame.lookAt(np, flat)
    r.AssemblyLinearVelocity = Vector3.zero
    r.AssemblyAngularVelocity = Vector3.zero
    if fm.target and not evade and (r.Position - fm.target.r.Position).Magnitude<=cfg.farm.dist + 6 then
        m1Fire()
        if cfg.farm.skills then useSkill() end
    end
end
