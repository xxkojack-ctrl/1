    local stand = pos + (off or Vector3.new(0, 0, 4))
    local far = (r.Position - stand).Magnitude > 40
    local eye = stand + Vector3.new(0, 1, 0)
    local look = Vector3.new(pos.X, eye.Y, pos.Z)
    holdAt((look - eye).Magnitude > 0.1 and CFrame.lookAt(eye, look) or CFrame.new(eye))
