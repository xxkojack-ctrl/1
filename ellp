local function buildText(o, t)
    local e, c, h = cfg.esp, t.c, t.h
    local nm
    if t.kind=="player" then
        nm = t.p.DisplayName
        if e.level then
            local ps = getSlot(t.p)
            local ex = ps and ps:FindFirstChild("Exp")
            local gl = ex and ex:FindFirstChild("Goal")
            if gl then nm = "Lv"..math.floor(gl.Value/60).." "..nm end
        end
        if e.breathing then
            local br = getBreathing(t.p)
            if br~="" then nm = nm.." ["..br.."]" end
        end
    else
        nm = c.Name
        if t.kind=="boss" then nm = "[BOSS] "..nm end
        if c:GetAttribute("Aggroed")==true then nm = '<font color="#ff4040">[AGGRO]</font> '..nm end
    end
    o.nameTxt = nm
    local parts = {}
    if e.dist then parts[#parts+1] = math.floor(t.d).."m" end
    if e.hpText then parts[#parts+1] = fmtN(h.Health).."/"..fmtN(h.MaxHealth) end
    if e.weapon then
        local w
        if t.kind=="player" then
            local tool = c:FindFirstChildOfClass("Tool")
            w = tool and tool.Name
        else
            w = c:GetAttribute("Equipped_Tool")
        end
        if type(w)=="string" and w~="" then parts[#parts+1] = w end
    end
    if t.kind=="player" then
        if e.clan then
            local cl = getClan(t.p)
            if cl~="" then parts[#parts+1] = cl end
        end
        if e.role then
            local rl = getDMG(t.p)
            if rl~="" then parts[#parts+1] = rl end
        end
    end
    o.infoTxt = table.concat(parts, " · ")
end

local function drawTarget(o, t, idx, vs, mouse, now)
    local e, c, h, r = cfg.esp, t.c, t.h, t.r
    local head = c:FindFirstChild("Head")
    local legs = h.RigType==Enum.HumanoidRigType.R6 and 2 or h.HipHeight
    local topW = head and (head.Position + Vector3.new(0, head.Size.Y/2 + 0.25, 0)) or (r.Position + Vector3.new(0, 2.5, 0))
    local botW = r.Position - Vector3.new(0, r.Size.Y/2 + legs + 0.1, 0)
    local st = cam:WorldToViewportPoint(topW)
    local sb = cam:WorldToViewportPoint(botW)
    local sr, vr = cam:WorldToViewportPoint(r.Position)
    if st.Z<=0 or sb.Z<=0 or sr.Z<=0 then hideObj(o); return end
    local ht = math.max(math.abs(sb.Y-st.Y), 8)
    local wd = math.max(ht*0.62, 6)
    local x, y = sr.X - wd/2, math.min(st.Y, sb.Y)
    local onScreen = vr or (x+wd>0 and x<vs.X and y+ht>0 and y<vs.Y)

    if e.visColor and now - o.visAt > 0.15 then
        o.visAt = now
        o.vis = not occluded(c, r.Position)
    end
    local col = targetColor(t, o)

    if e.tracer then
        local from
        if e.tracerFrom=="Center" then from = vs/2
        elseif e.tracerFrom=="Mouse" then from = mouse
        elseif e.tracerFrom=="Top" then from = Vector2.new(vs.X/2, 0)
        else from = Vector2.new(vs.X/2, vs.Y) end
        local to = e.tracerFrom=="Top" and Vector2.new(sr.X, y) or Vector2.new(sr.X, y+ht)
        o.trc.Visible = true
        o.trc.BackgroundColor3 = col
        line(o.trc, from, to, 1.5)
    else
        o.trc.Visible = false
    end

    if e.chams and idx<=28 then
        o.hl.Adornee = c
        o.hl.FillColor = col
        o.hl.OutlineColor = col
        o.hl.FillTransparency = e.chamsFill
        o.hl.Enabled = true
    else
        o.hl.Enabled = false
    end

    if not onScreen then
        o.boxO.Visible, o.boxF.Visible, o.cHold.Visible = false, false, false
        o.name.Visible, o.info.Visible, o.hpBg.Visible, o.stBg.Visible = false, false, false, false
        return
    end

    local full = e.box and e.boxStyle~="Corner"
    o.boxO.Visible = full
    o.boxF.Visible = full or (e.box and e.boxFill)
    o.cHold.Visible = e.box and e.boxStyle=="Corner"
    if o.boxF.Visible then
        place(o.boxF, x, y, wd, ht)
        o.boxS.Enabled = full
        o.boxS.Color = col
        o.boxF.BackgroundColor3 = col
        o.boxF.BackgroundTransparency = e.boxFill and 0.82 or 1
    end
    if full then place(o.boxO, x, y, wd, ht) end
    if o.cHold.Visible then
        place(o.cHold, x, y, wd, ht)
        for _, f in ipairs(o.corners) do f.BackgroundColor3 = col end
    end

    if now - o.txtAt > 0.25 then
        o.txtAt = now
        buildText(o, t)
    end
    local ts = e.textSize
    o.name.Visible = e.name
    if e.name then
        o.name.TextSize = ts
        o.name.Text = o.nameTxt or ""
        o.name.TextColor3 = col
        o.name.Position = UDim2.fromOffset(sr.X, y - 2)
    end
    local info = o.infoTxt or ""
    o.info.Visible = info~=""
    if info~="" then
        o.info.TextSize = ts - 1
        o.info.Text = info
        o.info.Position = UDim2.fromOffset(sr.X, y + ht + 2)
    end

    local hp = h.MaxHealth>0 and math.clamp(h.Health/h.MaxHealth, 0, 1) or 0
    o.hpBg.Visible = e.health
    if e.health then
        place(o.hpBg, x - 6, y, 3, ht)
        o.hpFg.Size = UDim2.fromScale(1, hp)
        o.hpFg.BackgroundColor3 = Color3.fromRGB(math.floor((1-hp)*235), math.floor(40 + hp*190), 60)
    end

    local stOn = false
    if e.stamina and t.kind=="player" then
        local cur, mx = getStamina(t.p)
        if mx>0 then
            stOn = true
            place(o.stBg, x + wd + 3, y, 3, ht)
            o.stFg.Size = UDim2.fromScale(1, math.clamp(cur/mx, 0, 1))
        end
    end
    o.stBg.Visible = stOn
end

